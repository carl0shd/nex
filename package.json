{
  "name": "nex",
  "version": "0.0.1",
  "private": true,
  "description": "Nex desktop application",
  "author": "Carlos Villalobos",
  "main": "./out/main/index.js",
  "scripts": {
    "lint": "vp lint",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "licenses:generate": "node scripts/generate-licenses.js",
    "build": "pnpm licenses:generate && pnpm typecheck && electron-vite build",
    "postinstall": "git config core.hooksPath .githooks && electron-builder install-app-deps && node helpers/speech/scripts/postinstall.js",
    "build:mac": "pnpm licenses:generate && electron-vite build && electron-builder --mac --config build/electron-builder.yml",
    "pack:mac": "pnpm licenses:generate && electron-vite build && electron-builder --mac --dir --config build/electron-builder.yml",
    "fmt": "vp fmt",
    "check": "vp check",
    "test": "vp test",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@pierre/diffs": "1.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-virtual": "^3.13.24",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-document": "^3.32.0",
    "@tiptap/extension-hard-break": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-mention": "^3.32.0",
    "@tiptap/extension-paragraph": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-text": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/suggestion": "^3.32.0",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^5.5.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "glimm": "^0.3.1",
    "liveline": "^0.0.7",
    "lucide-react": "^1.63.0",
    "marked": "^17.0.6",
    "node-pty": "^1.1.0",
    "react-resizable-panels": "^4.10.0",
    "react-router": "^8.3.1",
    "shadow-plugin": "^2.1.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tippy.js": "^6.3.7",
    "yaml": "^2.9.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.9.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^6.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-scan": "^0.5.3",
    "typescript": "~6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@10.30.2",
  "productName": "Nex"
}
